# Copy to .env and fill in real values. Never commit .env.

# Port for the Express server (serves the API and the web app)
PORT=3000

# Secret used to sign login tokens - use a long random string outside local development
AUTH_SECRET=change-me-to-a-long-random-string

# Google Gemini (server-side only). Without a key the AI triage falls back
# to a built-in keyword classifier, so the app still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Where the JSON database lives (default: data/helpdesk-db.json)
# DB_FILE=data/helpdesk-db.json
