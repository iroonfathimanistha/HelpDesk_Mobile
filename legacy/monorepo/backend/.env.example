# Copy to backend/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helpdesk

# JWT - use a long random string in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (admin web)
CORS_ORIGINS=http://localhost:5173

# Gemini (server-side only - never put this key in a mobile or web app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
