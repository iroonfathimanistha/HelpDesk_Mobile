# ==========================================================
# Backend environment variables — TEMPLATE ONLY
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.
# ==========================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skilled_services_dev
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Used only by `npm test`. Must be a separate database — tests wipe it.
DB_TEST_NAME=skilled_services_test
# Production (Render/AWS) only: full connection string, overrides the DB_* values
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------- Authentication (JWT) ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---------- CORS ----------
# Comma-separated list of allowed browser origins (mobile apps don't need this)
CORS_ORIGINS=http://localhost:3000

# ---------- First admin account (used by `npm run create-admin`) ----------
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# ---------- Not used yet (future phases) ----------
# AI_API_KEY=
# AI_MODEL=
# VISION_AI_API_KEY=
# VISION_AI_MODEL=
# MAPS_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
